# macOS / exFAT AppleDouble noise (Crucial_X9 is exFAT — these regenerate, never commit them)
._*
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ML artifacts — weights & datasets live on the Hugging Face Hub, NOT in git
outputs/
checkpoints/
wandb/
*.ckpt
*.pt
*.safetensors
data/
*.mp4
*.parquet

# ...but curated README/docs media IS tracked (see docs/assets/)
!docs/assets/
!docs/assets/*.mp4
!docs/assets/*.gif
!docs/assets/*.png
!docs/assets/*.jpg
# re-assert: macOS sidecars are never tracked, even under docs/assets/
._*
**/._*
.cache/

# Docs build
site/

# Editor / IDE
.vscode/
.idea/

# Secrets / local env
.env
*.local
# machine-specific config (e.g. configs/ports.local.sh — serial ports differ per laptop)
*.local.sh
