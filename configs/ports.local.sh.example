#!/usr/bin/env zsh
# ────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE, do not edit it in place:
#     cp configs/ports.local.sh.example configs/ports.local.sh
#
# The copy is git-ignored, because serial ports can differ per laptop. Nearly
# every command in the docs opens with `source configs/ports.local.sh`, so
# without it you get `Could not connect on port ''`: zsh expands an unset
# variable to nothing without complaining.
#
# The four ports below are the Φ bimanual rig's USB boards on macOS. The names
# come from each board's serial number, so they match on any Mac. If a command
# says a port is missing, run `lerobot-find-port` once per arm (unplug it when
# it prompts) and update your copy. Do NOT write `--port $(lerobot-find-port)`:
# the tool is interactive, command substitution swallows its prompt, and the
# terminal looks hung forever.
#
# Which calibration file each command uses, and why the id must match the arm:
# configs/calibration/README.md.
# ────────────────────────────────────────────────────────────────────────────

# ── Bimanual rig ─────────────────────────────────────────────────────────────
export LEFT_LEADER_PORT="/dev/tty.usbmodem5B790807501"
export LEFT_FOLLOWER_PORT="/dev/tty.usbmodem5B7B0096441"
export RIGHT_LEADER_PORT="/dev/tty.usbmodem5B7B0139311"
export RIGHT_FOLLOWER_PORT="/dev/tty.usbmodem5B790809471"

# LeRobot adds _left and _right to these ids itself (bi_so_follower.py:56,66;
# bi_so_leader.py:44,50), so they name four files:
#   robots/so_follower/phi_bi_follower_{left,right}.json
#   teleoperators/so_leader/phi_bi_leader_{left,right}.json
export BI_FOLLOWER_ID="phi_bi_follower"
export BI_LEADER_ID="phi_bi_leader"
#
#   lerobot-teleoperate \
#     --robot.type=bi_so_follower --robot.id=$BI_FOLLOWER_ID \
#     --robot.left_arm_config.port=$LEFT_FOLLOWER_PORT \
#     --robot.right_arm_config.port=$RIGHT_FOLLOWER_PORT \
#     --teleop.type=bi_so_leader --teleop.id=$BI_LEADER_ID \
#     --teleop.left_arm_config.port=$LEFT_LEADER_PORT \
#     --teleop.right_arm_config.port=$RIGHT_LEADER_PORT

# ── Single arm: the LEFT pair (the original arms) ────────────────────────────
# Every doc, checkpoint and rollout command in this repo says $FOLLOWER_PORT,
# $LEADER_PORT, $FOLLOWER_ID and $LEADER_ID. Keep these. phi_follower.json and
# phi_leader.json hold the same numbers as the left bimanual files.
export FOLLOWER_PORT="$LEFT_FOLLOWER_PORT"
export LEADER_PORT="$LEFT_LEADER_PORT"
export ROBOT_PORT="$FOLLOWER_PORT"                   # Makefile alias
export FOLLOWER_ID="phi_follower"
export LEADER_ID="phi_leader"
#
#   lerobot-teleoperate \
#     --robot.type=so101_follower --robot.port=$FOLLOWER_PORT --robot.id=$FOLLOWER_ID \
#     --teleop.type=so101_leader  --teleop.port=$LEADER_PORT  --teleop.id=$LEADER_ID

# ── Single arm: the RIGHT pair ───────────────────────────────────────────────
# Its own files. Never run the right arm with $FOLLOWER_ID: that is the left
# arm's file, and ENTER at LeRobot's mismatch prompt would write it into the
# right arm.
export RIGHT_FOLLOWER_ID="phi_bi_follower_right"
export RIGHT_LEADER_ID="phi_bi_leader_right"
#
#   lerobot-teleoperate \
#     --robot.type=so101_follower --robot.port=$RIGHT_FOLLOWER_PORT --robot.id=$RIGHT_FOLLOWER_ID \
#     --teleop.type=so101_leader  --teleop.port=$RIGHT_LEADER_PORT  --teleop.id=$RIGHT_LEADER_ID

echo "Φ ports loaded → L: leader=$LEFT_LEADER_PORT follower=$LEFT_FOLLOWER_PORT"
echo "                 R: leader=$RIGHT_LEADER_PORT follower=$RIGHT_FOLLOWER_PORT"
